<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Practice 2: "добавить зависимости с помощью Maven" -->
    <!-- Родительский POM Spring Boot сам тянет нужные версии всех библиотек,
         поэтому нам не нужно прописывать версии вручную у каждого dependency. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>kz.kbtu.demo</groupId>
    <artifactId>practice2-3-demo</artifactId>
    <version>1.0.0</version>
    <name>practice2-3-demo</name>
    <description>Practice 2 + Practice 3: Maven deps, dev/test profiles, typed config, constructor injection, conditional bean</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Веб-слой: даёт нам REST-контроллеры (Practice 3 их использует) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Даёт аннотацию @ConfigurationProperties и валидацию -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Тесты: JUnit 5, Mockito, AssertJ, Spring Test - всё сразу -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
